# ---- Supabase (project settings -> API) ----
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Secret for the "Send SMS" Auth Hook (Supabase -> Authentication -> Hooks).
# Format looks like: v1,whsec_XXXXXXXX
SUPABASE_AUTH_HOOK_SECRET=

# ---- OTP delivery provider ----
# mock = log the code to the server console (dev). cloud_api | twilio for production.
OTP_PROVIDER=mock
# WhatsApp Business Cloud API (OTP_PROVIDER=cloud_api):
# WHATSAPP_PHONE_ID=
# WHATSAPP_TOKEN=
# WHATSAPP_TEMPLATE_NAME=otp_verification
# WHATSAPP_TEMPLATE_LANG=en
# Twilio WhatsApp (OTP_PROVIDER=twilio):
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_FROM=whatsapp:+1415XXXXXXX

# ---- Claude (support bot) ----
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ---- Misc ----
NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=+91
NEXT_PUBLIC_APP_NAME=Sprinter Care
